{
  "manifest_version": 3,
  "name": "ApplyAI — Workday Field Detection",
  "version": "1.0.0",
  "description": "Detects Workday application form fields semantically and maps them to canonical profile keys.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://*.myworkdayjobs.com/*", "https://*.workday.com/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.myworkdayjobs.com/*", "https://*.workday.com/*"],
      "js": ["field-detector.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
